# Pump.fun bot. Start in paper mode; live swaps remain disabled.
BOT_MODE=paper
LIVE_CONFIRMATION=

# Public addresses of manually researched Pump.fun/PumpSwap traders, comma-separated.
WATCH_WALLETS=

# Solana JSON-RPC endpoint; public endpoint may rate-limit.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Dedicated Solana CLI keypair JSON file. Required only for live mode.
KEYPAIR_PATH=./wallet.json

# USD-risk limits.
MAX_ENTRY_USD=2.00
MAX_TOTAL_EXPOSURE_USD=3.00
MAX_OPEN_POSITIONS=3
MAX_ENTRIES_PER_DAY=3
DAILY_LOSS_LIMIT_USD=1.50
TOTAL_LOSS_LIMIT_USD=3.00
MIN_SOL_RESERVE=0.008
STARTING_PAPER_CASH_USD=10.00

# Aggressive Pump.fun filters. Pair data can lag on very new coins.
MIN_LIQUIDITY_USD=1000
MIN_PAIR_AGE_SECONDS=10
SLIPPAGE_BPS=300
MAX_MARKED_LOSS_PCT=0.25
TRAILING_STOP_PCT=0.20
TAKE_PROFIT_1_PCT=0.30
TAKE_PROFIT_2_PCT=0.60
TAKE_PROFIT_1_SELL_FRACTION=0.40
TAKE_PROFIT_2_SELL_FRACTION=0.30

# PumpPortal Local Transaction API priority fee in SOL (in addition to protocol/network fees).
PUMPPORTAL_PRIORITY_FEE_SOL=0.00001
POLL_SECONDS=4
EXPERIMENT_DURATION_DAYS=7
REQUEST_TIMEOUT_SECONDS=12
PAPER_SWAP_COST_USD=0.02

# Keep paper and live ledgers separate.
DATABASE_PATH=memecoin-pumpfun-paper.db
LOG_LEVEL=INFO
