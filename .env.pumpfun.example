# Pump.fun bot. Start in paper mode; live swaps remain disabled.
BOT_MODE=paper
LIVE_CONFIRMATION=

# Automatic top-trader discovery. Keep both credentials private and local.
# Copy ONLY the auth_token cookie value from your own Pump.fun request headers.
# Do not copy the entire Cookie header or commit this file.
PUMPFUN_AUTH_TOKEN=
# Optional legacy auth header fallback for older endpoint variants only.
PUMPFUN_BEARER_TOKEN=
# Get a PumpPortal API key from PumpPortal. Account-trade streams may incur usage fees.
PUMPPORTAL_API_KEY=

# Current Pump.fun frontend leaderboard endpoint observed in DevTools; may change.
PUMPFUN_LEADERBOARD_URL=https://frontend-api-v3.pump.fun/pnl-leaderboard
PUMPFUN_LEADERBOARD_PERIOD_PARAM=period
PUMPFUN_LEADERBOARD_DAY_VALUE=daily
PUMPFUN_LEADERBOARD_WEEK_VALUE=weekly
PUMPFUN_LEADERBOARD_MONTH_VALUE=monthly
PUMPFUN_LEADERBOARD_SORT_PARAM=sort
PUMPFUN_LEADERBOARD_SORT_VALUE=combined
PUMPFUN_LEADERBOARD_LIMIT=100
LEADERBOARD_REFRESH_SECONDS=300
TOP_TRADERS_COUNT=10
DEFAULT_LEADERBOARD_WINDOW=day
AUTO_COPY_ON_START=true
DASHBOARD_PORT=8765
# Optional PumpPortal token-trade subscription for faster price marks; can increase metered feed usage.
PUMPPORTAL_STREAM_TOKEN_PRICES=false
# High-risk: allow discovery-only entry from a fresh, verified canonical Pump curve without an indexed pair.
# Still requires fresh on-chain safety checks and >=$5,000 real curve liquidity; does not bypass leader-copy market checks.
ALLOW_UNINDEXED_PUMP_CURVE=false

# Independent new-token discovery; screening and live execution have separate opt-ins.
# Token creation events are free; token-trade subscriptions are metered.
TOKEN_DISCOVERY_ENABLED=false
# REAL FUNDS: keep false while evaluating shadow results. Requires BOT_MODE=live and LIVE_CONFIRMATION.
TOKEN_DISCOVERY_LIVE_ENABLED=false
# Code enforces a hard ceiling of $0.50 swap input; wallet debit can be higher due to rent/fees.
TOKEN_DISCOVERY_MAX_ENTRY_USD=0.50
TOKEN_DISCOVERY_MAX_WATCHED_TOKENS=8
TOKEN_DISCOVERY_WATCH_SECONDS=300
TOKEN_DISCOVERY_MAX_LAUNCHES_PER_MINUTE=30
# Persist up to 1,000 pending launches; if full, evict the oldest queued launch.
TOKEN_DISCOVERY_QUEUE_SIZE=1000
# Drop queued launches after 3 minutes and refuse live entries older than 5 minutes.
TOKEN_DISCOVERY_MAX_QUEUE_AGE_SECONDS=180
TOKEN_DISCOVERY_MAX_ENTRY_AGE_SECONDS=300
# Hard minimum: verified real bonding-curve liquidity must be at least $5,000.
TOKEN_DISCOVERY_MIN_LIQUIDITY_USD=5000
# These thresholds cannot be configured below 80/100 and 8 unique buyers.
TOKEN_DISCOVERY_MIN_SCORE=80
TOKEN_DISCOVERY_MIN_UNIQUE_BUYERS=8
# Max age for launches observed by this bot; capped in code at 24 hours.
TOKEN_DISCOVERY_MAX_TOKEN_AGE_HOURS=24
TOKEN_DISCOVERY_SHADOW_WINDOW_SECONDS=900

# Trending Solana-token scanner. Separate opt-in for actual live orders.
# Uses GeckoTerminal, same-pool DEX Screener cross-checks, RugCheck and direct mint RPC checks.
TRENDING_DISCOVERY_ENABLED=false
TRENDING_DISCOVERY_POLL_SECONDS=60
TRENDING_DISCOVERY_MAX_CANDIDATES=20
# Hard floors enforced by code; these cannot be lowered below $15k liquidity / $10k 1h volume.
TRENDING_MIN_LIQUIDITY_USD=15000
TRENDING_MIN_VOLUME_1H_USD=10000
TRENDING_MIN_SCORE=75
# Live trading is disabled unless BOTH scanner and live flags are true, BOT_MODE=live,
# LIVE_CONFIRMATION is set, and a valid Jupiter API key is configured locally.
TRENDING_DISCOVERY_LIVE_ENABLED=false
# Hard cap: $0.50 swap input per buy; network fees/token-account rent can debit more.
TRENDING_DISCOVERY_MAX_ENTRY_USD=0.50
TRENDING_MAX_PRICE_IMPACT_PCT=5.0
TRENDING_MAX_POOL_AGE_HOURS=720
# Get an API key via https://developers.jup.ag/portal; never commit it.
JUPITER_API_KEY=

# Optional extra wallets to follow manually (not required for top-trader discovery).
WATCH_WALLETS=

# Solana JSON-RPC endpoint; shared public endpoints can return HTTP 429.
# For repeated monitoring, use a free/private provider endpoint (e.g. Helius Free).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Push-based watched-wallet signature monitor via the matching RPC WebSocket URL.
# Set false if your RPC provider does not support WebSockets.
SOLANA_LOGS_WS_ENABLED=true
# Transaction version 1 is active on mainnet; raise this when the chain/provider requires it.
SOLANA_MAX_SUPPORTED_TRANSACTION_VERSION=1
# Throttle individual JSON-RPC calls and limit work on each watched wallet per poll.
SOLANA_RPC_MIN_INTERVAL_MS=300
SOLANA_RPC_429_COOLDOWN_SECONDS=30
SOLANA_MAX_SIGNATURES_PER_WALLET_POLL=8
# Old watched-wallet events are consumed but never copied after this age.
MAX_COPY_SIGNAL_AGE_SECONDS=30

# Dedicated Solana CLI keypair JSON file. Required only for live mode.
KEYPAIR_PATH=./wallet.json

# USD-risk limits.
MAX_ENTRY_USD=0.50
MAX_TOTAL_EXPOSURE_USD=1.00
MAX_OPEN_POSITIONS=1
MAX_ENTRIES_PER_DAY=1
# Entry circuit breakers pause new buys; they do not force-liquidate existing positions.
MAX_CONSECUTIVE_LOSSES=3
DAILY_LOSS_LIMIT_USD=0.50
TOTAL_LOSS_LIMIT_USD=1.00
MIN_SOL_RESERVE=0.025
STARTING_PAPER_CASH_USD=10.00

# Conservative Pump.fun filters; stricter gates reduce trade count but do not guarantee profit.
MIN_LIQUIDITY_USD=5000
MIN_PAIR_AGE_SECONDS=90
SLIPPAGE_BPS=300
# Aggressive overnight profile: an 18% marked-loss threshold; triggered algorithmic stop sells are attempted immediately.
MAX_MARKED_LOSS_PCT=0.18
# This grace applies to loss-making leader-followed exits; marked-loss and trailing stops bypass it.
MIN_HOLD_BEFORE_LOSS_EXIT_SECONDS=120
EMERGENCY_LOSS_BYPASS_PCT=0.50
TRAILING_STOP_PCT=0.12
TAKE_PROFIT_1_PCT=0.20
TAKE_PROFIT_2_PCT=0.45
TAKE_PROFIT_1_SELL_FRACTION=0.40
TAKE_PROFIT_2_SELL_FRACTION=0.30

# PumpPortal Local Transaction API priority fee in SOL (in addition to protocol/network fees).
PUMPPORTAL_PRIORITY_FEE_SOL=0.00001
POLL_SECONDS=4
EXPERIMENT_DURATION_DAYS=7
REQUEST_TIMEOUT_SECONDS=12
PAPER_SWAP_COST_USD=0.02

# Keep paper and live ledgers separate.
DATABASE_PATH=memecoin-pumpfun-paper.db
LOG_LEVEL=INFO
