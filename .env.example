# Start in paper mode. Live swaps are NOT enabled by default.
BOT_MODE=paper
LIVE_CONFIRMATION=
# Default false: Phase 4 cannot submit real-money buys without a separately approved rollout.
LIVE_ENTRIES_APPROVED=false

# Add manually vetted public trader wallet addresses, comma-separated.
WATCH_WALLETS=

# Jupiter Swap API V2. Use a locally stored key; do not commit this file.
JUPITER_API_KEY=

# Use your own provider URL if the public RPC rate-limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Required only for live mode; local Solana CLI keypair JSON file.
# Windows example: KEYPAIR_PATH=C:\Users\YOUR_USER\.config\solana\id.json
KEYPAIR_PATH=./wallet.json

# Conservative sample risk controls in USD unless labelled SOL.
# Loss thresholds block new entries when reached; existing holdings are not forcibly liquidated.
MAX_ENTRY_USD=0.50
MAX_TOTAL_EXPOSURE_USD=1.00
MAX_OPEN_POSITIONS=1
MAX_ENTRIES_PER_DAY=4
DAILY_LOSS_LIMIT_USD=0.50
TOTAL_LOSS_LIMIT_USD=1.00
MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
MIN_SOL_RESERVE=0.025
STARTING_PAPER_CASH_USD=10.00

# Token and execution filters.
MIN_LIQUIDITY_USD=5000
MIN_PAIR_AGE_SECONDS=90
SLIPPAGE_BPS=150
MAX_QUOTE_SHORTFALL_PCT=0.04
MAX_MARKED_LOSS_PCT=0.18
# Two-minute grace is for losing leader-followed exits; algorithmic stop exits are immediate.
MIN_HOLD_BEFORE_LOSS_EXIT_SECONDS=120
TRAILING_STOP_PCT=0.12
TAKE_PROFIT_1_PCT=0.20
TAKE_PROFIT_2_PCT=0.45
TAKE_PROFIT_1_SELL_FRACTION=0.40
TAKE_PROFIT_2_SELL_FRACTION=0.30

POLL_SECONDS=4
EXPERIMENT_DURATION_DAYS=7
REQUEST_TIMEOUT_SECONDS=12
PAPER_SWAP_COST_USD=0.02
DATABASE_PATH=memecoin-paper.db
LOG_LEVEL=INFO
